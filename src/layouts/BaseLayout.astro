---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  tags,
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://balkon-bepflanzen.de';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Balkon-Bepflanzen.de',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Ratgeber für Balkongärtnerei in Deutschland',
  founder: {
    '@type': 'Person',
    name: 'Lisa Berger',
  },
  sameAs: [],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Balkon-Bepflanzen.de',
  url: siteUrl,
  description: 'Praxisnahe Tipps und Ratgeber rund ums Balkon bepflanzen – für Anfänger und Fortgeschrittene in Deutschland.',
  inLanguage: 'de-DE',
  publisher: {
    '@type': 'Organization',
    name: 'Balkon-Bepflanzen.de',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2d6a4f" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "/favicon.svg"} />
    <link rel="icon" href={import.meta.env.BASE_URL + "/favicon.ico"} sizes="32x32" />
    <link rel="apple-touch-icon" href={import.meta.env.BASE_URL + "/apple-touch-icon.svg"} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      noindex={noindex}
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schema && (
      Array.isArray(schema)
        ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google AdSense: Client-ID nach Freischaltung eintragen
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    -->
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <main id="main" class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
