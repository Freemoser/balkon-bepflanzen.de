---
interface Props {
  slot?: 'header' | 'inarticle' | 'sidebar' | 'footer';
  label?: string;
}

const { slot = 'inarticle', label = 'Anzeige' } = Astro.props;
const className = slot === 'sidebar' ? 'ad-slot ad-slot-sidebar' : slot === 'inarticle' ? 'ad-slot ad-slot-inarticle' : 'ad-slot';
---

<!-- Google AdSense Placeholder – ersetze data-ad-slot mit deiner Ad-Unit-ID -->
<div class="ad-wrapper">
  <p class="ad-label">{label}</p>
  <div class={className} data-ad-slot={slot} role="complementary" aria-label="Werbeanzeige">
    <!--
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
      data-ad-slot="XXXXXXXXXX"
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    -->
    <span>Google AdSense</span>
  </div>
</div>
