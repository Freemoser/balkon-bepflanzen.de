---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Balkon-Tipps direkt in dein Postfach',
  description = 'Erhalte saisonale Pflanz-Tipps, Gieß-Erinnerungen und exklusive Ratgeber – kostenlos und jederzeit abbestellbar.',
} = Astro.props;
---

<section class="newsletter" aria-labelledby="newsletter-heading">
  <div class="container">
    <h2 id="newsletter-heading">{title}</h2>
    <p>{description}</p>
    <form class="newsletter-form" action="#" method="post" onsubmit="event.preventDefault(); this.querySelector('[data-success]').hidden = false; this.querySelector('[data-fields]').hidden = true;">
      <div data-fields style="display:contents">
        <label for="newsletter-email" class="sr-only">E-Mail-Adresse</label>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          placeholder="deine@email.de"
          required
          autocomplete="email"
          aria-required="true"
        />
        <button type="submit" class="btn">Anmelden</button>
      </div>
      <p data-success hidden style="color:white;font-weight:600;margin:0">
        Danke! Bitte bestätige deine E-Mail-Adresse.
      </p>
    </form>
    <p class="newsletter-note">Kein Spam. Jederzeit abbestellbar. Datenschutzkonform.</p>
  </div>
</section>
