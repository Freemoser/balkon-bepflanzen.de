---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lisa Berger',
  jobTitle: 'Balkon-Gärtnerin & Autorin',
  url: 'https://balkon-bepflanzen.de/ueber-mich/',
  description: 'Autorin von Balkon-Bepflanzen.de – teilt praxiserprobte Tipps zur Balkongärtnerei in Deutschland.',
  knowsAbout: ['Balkongärtnerei', 'Urban Gardening', 'Kräuteranbau', 'Balkonpflanzen'],
  nationality: 'DE',
};
---

<BaseLayout
  title="Über mich"
  description="Lerne Lisa Berger kennen – die Autorin hinter Balkon-Bepflanzen.de. Seit über 10 Jahren teilt sie praxiserprobte Tipps zur Balkongärtnerei."
  schema={personSchema}
>
  <Breadcrumbs items={[{ label: 'Über mich' }]} />

  <header class="page-header">
    <div class="container">
      <h1>Über mich</h1>
      <p>Hallo, ich bin Lisa – und ich verwandle Balkone in grüne Paradiese.</p>
    </div>
  </header>

  <div class="prose-page">
    <div class="author-box" style="margin-top:0;margin-bottom:var(--space-2xl)">
      <div class="author-avatar" aria-hidden="true" style="width:5rem;height:5rem;font-size:2rem">LB</div>
      <div>
        <h2 style="margin:0 0 var(--space-xs);font-size:1.5rem">Lisa Berger</h2>
        <p style="margin:0;color:var(--color-text-muted)">Balkon-Gärtnerin · Autorin · Stadtgärtnerin aus München</p>
      </div>
    </div>

    <p>
      Vor über zehn Jahren stand ich vor meinem ersten Balkon – drei Quadratmeter Beton, Blick auf eine
      befahrene Straße, null Gartenerfahrung. Heute ernte ich Tomaten, Basilikum und Erdbeeren direkt
      vor der Küchentür und helfe tausenden Menschen dabei, dasselbe zu schaffen.
    </p>

    <h2>Warum Balkon-Bepflanzen.de?</h2>
    <p>
      Die meisten Gartentipps im Netz richten sich an Menschen mit Beet und Komposthaufen. Ich schreibe
      für alle, die <strong>nur einen Balkon, eine Terrasse oder ein Fensterbrett</strong> haben – und
      trotzdem frisches Grün, bunte Blüten und selbst gezogenen Salat wollen.
    </p>
    <p>
      Jeder Artikel basiert auf eigenen Versuchen, Fehlern und Erfolgen. Keine Theorie von der
      Schreibtischplatte, sondern erprobte Methoden für das deutsche Klima: von den Spätfrösten im Mai
      bis zu den Hitzewellen im August.
    </p>

    <h2>Was du hier findest</h2>
    <ul>
      <li>Schritt-für-Schritt-Anleitungen für Anfänger</li>
      <li>Pflanzenempfehlungen für Sonne, Halbschatten und Schatten</li>
      <li>Budget-Tipps und DIY-Ideen</li>
      <li>Saisonkalender abgestimmt auf Deutschland</li>
      <li>Ökologische Balkongestaltung für Insekten und Artenvielfalt</li>
    </ul>

    <h2>Mein Versprechen</h2>
    <p>
      Keine Clickbait-Titel, keine bezahlten Pseudo-Empfehlungen ohne Kennzeichnung, kein
      Fachchinesisch. Stattdessen: ehrliche Tipps, die funktionieren – und die du noch heute umsetzen
      kannst.
    </p>
    <p>
      Du hast Fragen oder möchtest ein Thema vorschlagen?
      Schreib mir über das <a href={import.meta.env.BASE_URL + "/impressum/"}>Impressum</a> – ich freue mich über jede Nachricht.
    </p>

    <p style="margin-top:var(--space-2xl)">
      <a href={import.meta.env.BASE_URL + "/blog/"} class="btn btn-primary">Zu den Ratgebern</a>
    </p>
  </div>

  <Newsletter />
</BaseLayout>
