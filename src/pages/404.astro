---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die angeforderte Seite existiert nicht. Zurück zur Startseite von Balkon-Bepflanzen.de."
  noindex={true}
>
  <div class="error-page">
    <div class="error-code" aria-hidden="true">404</div>
    <h1>Seite nicht gefunden</h1>
    <p>
      Diese Seite ist leider verwelkt. Vielleicht wurde sie umgepflanzt – oder der Link ist vertrocknet.
      Keine Sorge, auf dem Balkon wartet genug Grün auf dich.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-md);justify-content:center">
      <a href={import.meta.env.BASE_URL + "/"} class="btn btn-primary">Zur Startseite</a>
      <a href={import.meta.env.BASE_URL + "/blog/"} class="btn btn-secondary">Zum Ratgeber</a>
    </div>
  </div>
</BaseLayout>
