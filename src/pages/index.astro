---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import { getFeaturedPosts, getPublishedPosts } from '../utils/blog';

const featured = await getFeaturedPosts(3);
const allPosts = await getPublishedPosts();
const latest = allPosts.slice(0, 6);

const features = [
  {
    icon: '🌱',
    title: 'Für Anfänger geeignet',
    text: 'Schritt-für-Schritt-Anleitungen, die auch ohne grünen Daumen funktionieren. Starte noch heute mit deinem ersten Balkonkasten.',
  },
  {
    icon: '☀️',
    title: 'Für jede Lage',
    text: 'Süd-, West-, Ost- oder Nordbalkon? Wir zeigen dir die besten Pflanzen und Strategien für jede Ausrichtung und jeden Schattengrad.',
  },
  {
    icon: '💰',
    title: 'Budgetfreundlich',
    text: 'Große Ernte und üppige Blüten müssen nicht teuer sein. Spare mit Stecklingen, Eigenanzucht und cleveren DIY-Ideen.',
  },
  {
    icon: '📅',
    title: 'Saisonal geplant',
    text: 'Unser Pflanzkalender sagt dir genau, was du wann säen, pflanzen und ernten solltest – abgestimmt auf das deutsche Klima.',
  },
  {
    icon: '🐝',
    title: 'Insektenfreundlich',
    text: 'Gestalte deinen Balkon als kleinen Lebensraum für Bienen, Schmetterlinge und Nützlinge – schön und ökologisch wertvoll.',
  },
  {
    icon: '🍅',
    title: 'Essbares grün',
    text: 'Von Tomaten über Kräuter bis zu Erdbeeren: Frisches Gemüse und Gewürze direkt vor der Wohnungstür ernten.',
  },
];
---

<BaseLayout
  title="Balkon-Bepflanzen.de"
  description="Der praxisnahe Ratgeber für Balkongärtnerei in Deutschland. Lerne, wie du deinen Balkon bepflanzt – von Anfänger-Tipps bis Profi-Tricks für Sonne, Schatten und jede Saison."
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>Dein Balkon. Dein Garten. Deine Ernte.</h1>
      <p class="hero-lead">
        Praxisnahe Tipps zum Balkon bepflanzen – egal ob sonnig, schattig, groß oder winzig.
        Starte noch heute und verwandle deinen Balkon in eine grüne Oase.
      </p>
      <div class="hero-actions">
        <a href={import.meta.env.BASE_URL + "/blog/"} class="btn btn-primary btn-lg">Ratgeber entdecken</a>
        <a href={import.meta.env.BASE_URL + "/blog/balkon-bepflanzen-anfaenger/"} class="btn btn-secondary btn-lg">Für Anfänger</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="features-heading">Alles, was du für deinen Balkongarten brauchst</h2>
        <p>Von der ersten Aussaat bis zur reichen Ernte – fundiertes Wissen, verständlich erklärt.</p>
      </div>
      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot slot="header" />
  </div>

  <section class="section section-alt" aria-labelledby="blog-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="blog-heading">Neueste Ratgeber</h2>
        <p>Aktuelle Tipps und Anleitungen rund ums Balkon bepflanzen.</p>
      </div>
      <div class="blog-grid">
        {latest.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
      <div class="section-cta">
        <a href={import.meta.env.BASE_URL + "/blog/"} class="btn btn-primary">Alle Artikel ansehen</a>
      </div>
    </div>
  </section>

  {featured.length > 0 && featured[0] && (
    <section class="section" aria-labelledby="start-heading">
      <div class="container" style="text-align:center;max-width:40rem;margin:0 auto;">
        <h2 id="start-heading" style="margin-top:0">Bereit, loszulegen?</h2>
        <p style="color:var(--color-text-muted);margin-bottom:var(--space-xl)">
          Unser Anfänger-Guide führt dich Schritt für Schritt vom leeren Balkon zur blühenden Oase.
          Kein Vorwissen nötig – nur Lust auf Grün.
        </p>
        <a href={import.meta.env.BASE_URL + "/blog/balkon-bepflanzen-anfaenger/"} class="btn btn-primary btn-lg">
          Jetzt Anfänger-Guide lesen
        </a>
      </div>
    </section>
  )}

  <Newsletter />
</BaseLayout>
